//===== rAthena Script =======================================
//= Element Endow NPC
//===== By: ==================================================
//= Claude Code
//===== Current Version: =====================================
//= 1.2
//===== Compatible With: =====================================
//= rAthena Project
//===== Description: =========================================
//= NPC that provides elemental weapon enchantments.
//= Requires elemental stones + 2,500z fee.
//= Offers Fire, Water, Wind, Earth, and Holy (Aspersio).
//===== Additional Comments: =================================
//= 1.0 Initial script - placed near healers for convenience
//= 1.1 Added 3-minute grace period for free re-endow (for MVP hunters who die)
//= 1.2 Now requires elemental stones (Flame Heart, Mystic Frozen, etc.) + 2,500z
//============================================================

-	script	Enchanter	-1,{

	// Configurable settings
	.@Price = 2500;                     // Zeny cost per endow
	.@Duration = ${ENDOW_DURATION};     // Duration in milliseconds
	.@FreeLevel = ${ENDOW_FREE_LEVEL};  // Free service for players at or below this level
	.@GracePeriod = 180;                // Grace period in seconds (3 minutes)

	// Item IDs for elemental stones
	setarray .@ReqItem[1], 994, 995, 996, 997, 523;  // Flame Heart, Mystic Frozen, Rough Wind, Great Nature, Holy Water
	setarray .@ReqName$[1], "Flame Heart", "Mystic Frozen", "Rough Wind", "Great Nature", "Holy Water";

	// Check for grace period (recent endow within 3 minutes)
	.@TimeSinceLast = gettimetick(2) - ENDOW_LAST_TIME;
	.@InGrace = (ENDOW_LAST_TIME > 0 && .@TimeSinceLast < .@GracePeriod);

	// Free service for low-level adventurers (waives both item and zeny)
	.@IsFree = 0;
	if (.@FreeLevel > 0 && BaseLevel <= .@FreeLevel) {
		.@IsFree = 1;
		message strcharinfo(0), "Free enchantment for adventurers level " + .@FreeLevel + " and below!";
	}

	// If in grace period, offer free re-endow option
	if (.@InGrace && !.@IsFree) {
		// Check if they've exhausted their free uses
		if (ENDOW_GRACE_USES >= 10) {
			mes "[Elemental Enchanter]";
			mes "Ah, back so soon? Again?";
			mes " ";
			mes "My magical reserves aren't infinite, you know.";
			mes "Even a Sage needs compensation~";
			next;
			.@choice = 0;  // Force normal menu
		} else {
			.@TimeLeft = .@GracePeriod - .@TimeSinceLast;
			.@LastElement$ = "";
			switch(ENDOW_LAST_ELEMENT) {
				case 1: .@LastElement$ = "^FF0000Fire^000000"; break;
				case 2: .@LastElement$ = "^0000FFWater^000000"; break;
				case 3: .@LastElement$ = "^00FF00Wind^000000"; break;
				case 4: .@LastElement$ = "^8B4513Earth^000000"; break;
				case 5: .@LastElement$ = "^FFFF00Holy^000000"; break;
			}
			mes "[Elemental Enchanter]";
			mes "Ah, you've returned!";
			mes "Lost your enchantment already?";
			mes " ";
			mes "No matter. I still sense the " + .@LastElement$ + " residue.";
			next;
			switch(select("Re-apply " + .@LastElement$ + " (Free):Choose different element:Cancel")) {
				case 1:
					// Free re-apply of last element (waives both item and zeny)
					.@choice = ENDOW_LAST_ELEMENT;
					.@IsFree = 1;
					ENDOW_GRACE_USES = ENDOW_GRACE_USES + 1;
					break;
				case 2:
					// Continue to normal menu
					.@choice = 0;
					break;
				case 3:
					close;
			}
		}
	} else {
		.@choice = 0;
	}

	// Normal menu if no grace re-apply chosen
	if (.@choice == 0) {
		mes "[Elemental Enchanter]";
		mes "I can imbue your weapon with elemental power.";
		mes " ";
		if (.@IsFree) {
			mes "Cost: ^00FF00Free^000000 (for new adventurers)";
		} else {
			mes "Bring me an elemental stone and ^0000FF" + callfunc("F_InsertComma", .@Price) + " Zeny^000000.";
		}
		mes "Duration: ^0000FF10 minutes^000000";
		next;

		.@choice = select("^FF0000Fire^000000 (vs Earth/Undead):^0000FFWater^000000 (vs Fire):^00FF00Wind^000000 (vs Water):^8B4513Earth^000000 (vs Wind):^FFFF00Holy^000000 (vs Shadow/Undead):Cancel");
		if (.@choice == 6) close;
	}

	// Set element based on choice
	switch(.@choice) {
		case 1:
			.@element$ = "Fire";
			.@sc = SC_FIREWEAPON;
			.@effect = EF_FLAMELAUNCHER;
			break;
		case 2:
			.@element$ = "Water";
			.@sc = SC_WATERWEAPON;
			.@effect = EF_FROSTWEAPON;
			break;
		case 3:
			.@element$ = "Wind";
			.@sc = SC_WINDWEAPON;
			.@effect = EF_LIGHTNINGLOADER;
			break;
		case 4:
			.@element$ = "Earth";
			.@sc = SC_EARTHWEAPON;
			.@effect = EF_SEISMICWEAPON;
			break;
		case 5:
			.@element$ = "Holy";
			.@sc = SC_ASPERSIO;
			.@effect = EF_ASPERSIO;
			break;
	}

	// Check requirements (skip if free)
	if (!.@IsFree) {
		// Check item
		if (countitem(.@ReqItem[.@choice]) < 1) {
			mes "[Elemental Enchanter]";
			mes "You need a ^0000FF" + .@ReqName$[.@choice] + "^000000 for " + .@element$ + " enchantment.";
			mes " ";
			mes "You can buy one from the Tool Dealer in Prontera center.";
			close;
		}
		// Check zeny
		if (Zeny < .@Price) {
			mes "[Elemental Enchanter]";
			mes "You need " + callfunc("F_InsertComma", .@Price) + " Zeny for this service.";
			close;
		}

		// Deduct item and zeny
		delitem .@ReqItem[.@choice], 1;
		Zeny -= .@Price;
		ENDOW_GRACE_USES = 0;  // Reset usage counter on payment
	}

	// Apply enchantment
	specialeffect2 .@effect;
	sc_start .@sc, .@Duration, 5;  // Level 5 for maximum effectiveness

	// Store last endow for grace period
	ENDOW_LAST_ELEMENT = .@choice;
	ENDOW_LAST_TIME = gettimetick(2);

	mes "[Elemental Enchanter]";
	mes "Your weapon now burns with ^FF0000" + .@element$ + "^000000 power!";
	mes " ";
	mes "The enchantment will last for 10 minutes.";
	if (!.@IsFree) {
		mes " ";
		mes "^777777(Free re-endow available for 3 minutes)^000000";
	}
	close;
}


